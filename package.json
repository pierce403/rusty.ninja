{
  "name": "rusty-ninja",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && npm run verify:pwa",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "verify:pwa": "node scripts/verify-pwa.mjs",
    "build:cloudflare": "npm run build && node scripts/cloudflare-assets.mjs",
    "deploy": "wrangler deploy",
    "check:deploy": "npm run build:cloudflare && wrangler deploy --dry-run"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "wrangler": "4.149.0"
  }
}
